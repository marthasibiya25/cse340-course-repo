<%- include("partials/header", { title: title }) %>

    <main class="container">

        <h1>
            Welcome, <%= accountData.account_firstname %>
        </h1>


        <p>
            Role:
            <%= accountData.account_type %>
        </p>


        <% if (accountData.account_type==="Admin" ) { %>

            <a href="/users" class="button">
                View Registered Users
            </a>

            <% } %>



                <!-- Volunteer Projects Section -->

                <section class="volunteer-projects">

                    <h2>
                        My Volunteer Projects
                    </h2>


                    <% if (volunteerProjects && volunteerProjects.length> 0) { %>


                        <% volunteerProjects.forEach(project=> { %>


                            <div class="card">


                                <h3>
                                    <%= project.project_name %>
                                </h3>


                                <p>
                                    <strong>
                                        Organization:
                                    </strong>

                                    <%= project.organization_name %>
                                </p>


                                <p>
                                    <strong>
                                        Description:
                                    </strong>

                                    <%= project.description %>
                                </p>


                                <p>
                                    <strong>
                                        Location:
                                    </strong>

                                    <%= project.location %>
                                </p>


                                <p>
                                    <strong>
                                        Date:
                                    </strong>

                                    <%= project.date %>
                                </p>


                                <a href="/project/<%= project.project_id %>" class="button">
                                    View Project
                                </a>


                                <a href="/remove-volunteer/<%= project.project_id %>" class="button">
                                    Remove Volunteer
                                </a>


                            </div>


                            <% }) %>


                                <% } else { %>


                                    <p>
                                        You have not volunteered for any projects yet.
                                    </p>


                                    <% } %>


                </section>


    </main>


    <%- include("partials/footer") %>
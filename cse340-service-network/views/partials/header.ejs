<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title %> | Service Network
    </title>

    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <header>
        <div class="container">
            <h1>Service Network</h1>

            <nav>
                <ul>

                    <li>
                        <a href="/">Home</a>
                    </li>

                    <li>
                        <a href="/organizations">Organizations</a>
                    </li>

                    <li>
                        <a href="/projects">Projects</a>
                    </li>

                    <li>
                        <a href="/categories">Categories</a>
                    </li>


                    <% if (accountData) { %>


                        <% if (accountData.account_role==="Admin" ) { %>

                            <li>
                                <a href="/users">
                                    Users
                                </a>
                            </li>

                            <li>
                                <a href="/new-organization">
                                    Add Organization
                                </a>
                            </li>

                            <li>
                                <a href="/new-project">
                                    Add Project
                                </a>
                            </li>

                            <li>
                                <a href="/new-category">
                                    Add Category
                                </a>
                            </li>

                            <% } %>


                                <li>
                                    <a href="/account/logout">
                                        Logout
                                    </a>
                                </li>


                                <% } else { %>


                                    <li>
                                        <a href="/account/login">
                                            Login
                                        </a>
                                    </li>


                                    <li>
                                        <a href="/account/register">
                                            Register
                                        </a>
                                    </li>


                                    <% } %>


                </ul>
            </nav>
        </div>
    </header>


    <!-- Flash Messages -->
    <% if (messages.success) { %>

        <div class="flash success">
            <%= messages.success %>
        </div>

        <% } %>


            <% if (messages.error) { %>

                <div class="flash error">
                    <%= messages.error %>
                </div>

                <% } %>
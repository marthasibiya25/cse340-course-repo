<%- include("partials/header", { title: title }) %>

    <main class="container">

        <h1>
            <%= project.project_name %>
        </h1>


        <section class="project-details">

            <div class="card">

                <h2>
                    Project Details
                </h2>


                <p>
                    <strong>Description:</strong>
                    <%= project.description %>
                </p>


                <p>
                    <strong>Location:</strong>
                    <%= project.location %>
                </p>


                <p>
                    <strong>Date:</strong>
                    <%= project.date %>
                </p>


                <p>
                    <strong>Organization:</strong>
                    <%= project.organization_name %>
                </p>


                <% if (project.categories) { %>

                    <p>
                        <strong>Categories:</strong>
                        <%= project.categories %>
                    </p>

                    <% } %>


                        <!-- Volunteer Feature -->

                        <% if (accountData) { %>


                            <% if (isVolunteer) { %>

                                <div class="volunteer-section">

                                    <p>
                                        You are volunteering for this project.
                                    </p>


                                    <a href="/remove-volunteer/<%= project.project_id %>" class="button">
                                        Remove Volunteer
                                    </a>

                                </div>


                                <% } else { %>


                                    <div class="volunteer-section">

                                        <a href="/volunteer/<%= project.project_id %>" class="button">
                                            Volunteer for this project
                                        </a>

                                    </div>


                                    <% } %>


                                        <% } %>


            </div>


        </section>


    </main>


    <%- include("partials/footer") %>
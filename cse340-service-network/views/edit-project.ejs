<%- include("partials/header", { title: title }) %>

    <main class="container">

        <h1>
            <%= title %>
        </h1>


        <% if (error) { %>

            <p class="error">
                <%= error %>
            </p>

            <% } %>


                <form action="/edit-project/<%= project.project_id %>" method="POST">


                    <label>
                        Project Name:
                    </label>

                    <input type="text" name="project_name" value="<%= project.project_name %>" required>


                    <label>
                        Description:
                    </label>

                    <textarea name="description" required><%= project.description %></textarea>


                    <label>
                        Location:
                    </label>

                    <input type="text" name="location" value="<%= project.location %>" required>


                    <label>
                        Date:
                    </label>

                    <input type="date" name="date" value="<%= project.date.toISOString().split('T')[0] %>" required>


                    <label>
                        Organization:
                    </label>

                    <select name="organization_id" required>


                        <% organizations.forEach(org=> { %>

                            <option value="<%= org.organization_id %>" <%=org.organization_id==project.organization_id
                                ? "selected" : "" %>
                                >

                                <%= org.organization_name %>

                            </option>

                            <% }) %>


                    </select>


                    <button type="submit">
                        Update Project
                    </button>


                </form>


    </main>


    <%- include("partials/footer") %>